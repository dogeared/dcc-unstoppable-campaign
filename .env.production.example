# Copy to .env beside compose.production.yaml on the NAS.

# Database
DB_NAME=unstoppable
DB_USER=unstoppable
DB_PASSWORD=change-me

# Shared Docker network used by cloudflared and Keycloak
SHARED_NETWORK=nas-shared

# Central Keycloak. Both URLs are the public hostname: the app reaches it
# through the same Cloudflare tunnel as the browser.
KEYCLOAK_PUBLIC_URL=https://auth.dogeared.dev
KEYCLOAK_INTERNAL_URL=https://auth.dogeared.dev
KEYCLOAK_REALM=unstoppable
KEYCLOAK_CLIENT_ID=unstoppable-app

JAVA_OPTS=-XX:MaxRAMPercentage=75
