# Copy to .env and adjust. Docker Compose reads .env automatically.

# Host ports
APP_PORT=8084
DB_PORT=5435

# Keycloak client
KEYCLOAK_CLIENT_ID=unstoppable-app

# Browser-facing Keycloak URL (also the token issuer). Local development uses
# the shared Keycloak through the mkcert reverse proxy in
# ~/Projects/local-keycloak.
KEYCLOAK_PUBLIC_URL=https://auth.dev.dogeared.dev
# Back-channel URL. Inside compose the app reaches Keycloak by service name.
# The realm pins frontendUrl, so the issuer still matches the public host.
KEYCLOAK_INTERNAL_URL=http://keycloak:8080

KEYCLOAK_REALM=unstoppable
